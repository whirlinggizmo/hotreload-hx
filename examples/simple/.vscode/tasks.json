{
	"version": "2.0.0",
	// every task's, unless it sets its own
	"options": {
		"cwd": "${workspaceFolder}"
	},
	"presentation": {
		"reveal": "always",
		"clear": true,
		"showReuseMessage": false,
		"close": false
	},
	"tasks": [
		{
			"label": "build hot",
			"detail": "hot reload: edit src/Simple.hx while it runs",
			"type": "shell",
			"command": "haxe",
			"args": ["common.hxml", "-D", "hotreload", "-debug", "-lib", "hxcpp-debug-server", "--cpp", "out/hot"],
			"group": "build",
			"problemMatcher": ["$haxe-absolute", "$haxe"]
		},
		{
			"label": "build debug",
			"detail": "no hot reload",
			"type": "shell",
			"command": "haxe",
			"args": ["common.hxml", "-debug", "-lib", "hxcpp-debug-server", "--cpp", "out/debug"],
			"group": "build",
			"problemMatcher": ["$haxe-absolute", "$haxe"]
		},
		{
			"label": "build release",
			"type": "shell",
			"command": "haxe",
			"args": ["common.hxml", "--cpp", "out/release"],
			"group": "build",
			"problemMatcher": ["$haxe-absolute", "$haxe"]
		},
		{
			"label": "run release",
			"type": "shell",
			"command": "${workspaceFolder}/out/release/Main",
			"dependsOn": "build release",
			"problemMatcher": []
		},
		{
			"label": "haxe: active configuration",
			"type": "haxe",
			"args": "active configuration",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$haxe-absolute", "$haxe"]
		}
	]
}
