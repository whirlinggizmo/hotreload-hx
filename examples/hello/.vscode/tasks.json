{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}"
	},
	"presentation": {
		"reveal": "always",
		"clear": true,
		"showReuseMessage": false,
		"close": false
	},
	"tasks": [
		{
			"label": "build release",
			"detail": "web/hello.js, no hot reload",
			"type": "shell",
			"command": "haxe",
			"args": ["build.hxml"],
			"group": "build",
			"problemMatcher": ["$haxe-absolute", "$haxe"]
		},
		{
			"label": "haxe: active configuration",
			"type": "haxe",
			"args": "active configuration",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$haxe-absolute", "$haxe"]
		}
	]
}
