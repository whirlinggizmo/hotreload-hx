{
	"version": "0.2.0",
	"configurations": [
		{
			// Opens the page that `haxe dev.hxml` serves, so start that first. Breakpoints in
			// src/*.hx work through the source maps, and keep working after a reload.
			"name": "Hot (Chrome)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:8080/",
			"webRoot": "${workspaceFolder}/web"
		}
	]
}
